{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed physical-device manual validation session",
  "type": "object",
  "required": ["platform", "build_version", "physical_device", "operator", "recorded_at", "hardware", "checks", "attachments"],
  "properties": {
    "platform": {"enum": ["android", "ios", "windows"]},
    "build_version": {"type": "string", "minLength": 1},
    "physical_device": {"const": true},
    "operator": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "hardware": {"type": "string", "minLength": 1},
    "observations": {"type": "string"},
    "checks": {
      "type": "object",
      "required": ["screen_reader", "font_scaling", "contrast", "low_memory_recovery", "encoder_repeat"],
      "additionalProperties": {"enum": ["passed", "failed", "not_run"]}
    },
    "attachments": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  }
}
