{
  "name": "studyfrog-studio",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "assets": "node scripts/install-ffmpeg-core.mjs",
    "predev": "npm run assets",
