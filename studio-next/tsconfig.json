{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true, "noEmit": true, "module": "esnext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "esModuleInterop": true, "skipLibCheck": true, "allowJs": true,
    "incremental": true, "resolveJsonModule": true, "isolatedModules": true, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
